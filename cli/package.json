{
  "name": "antmay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.6.2",
  "bin": {
    "antmay": "./dist/main.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint src",
    "check": "npm run typecheck && npm run test && npm run build",
    "demo": "node scripts/demo.mjs",
    "demo:all": "node scripts/demo-all.mjs",
    "trace": "node scripts/trace.mjs",
    "trace:compare": "node scripts/trace/compare.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@ai-hero/sandcastle": "0.12.0"
  }
}
